local BADGE = {
    Pending = Color3.fromRGB(150, 150, 172),
    Sent = GREEN, Invalid = AMBER, Failed = RED,
}
local entries, entryOrder, entryCounter = {}, {}, 0

local function setBadge(e, status)
    e.badge.Text = status
    e.badge.TextColor3 = BADGE[status] or GRAY
    e.status = status
end

function Hooks.history(code, status)
    local e = entries[code]
    if e then setBadge(e, status) return end
    entryCounter = entryCounter + 1
    local row = new("TextButton", {
        Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 28),
        BackgroundColor3 = Color3.fromRGB(16, 16, 26), BorderSizePixel = 0,
        LayoutOrder = -entryCounter, ZIndex = 4, Parent = codeScroll,
    }, { corner(6) })
    label(row, {
        Text = code, Font = Enum.Font.Code, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, -78, 1, 0), Position = UDim2.fromOffset(8, 0), ZIndex = 5,
    })
    local badge = label(row, {
        Text = "", Font = Enum.Font.GothamBold, TextSize = 9,
        TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.fromOffset(64, 28),
        Position = UDim2.new(1, -70, 0, 0), ZIndex = 5,
    })
    e = { row = row, badge = badge, code = code }
    entries[code] = e
    entryOrder[#entryOrder + 1] = code
    setBadge(e, status)
    emptyLabel.Visible = false

    row.MouseEnter:Connect(function() tween(row, { BackgroundColor3 = Color3.fromRGB(26, 26, 42) }) end)
    row.MouseLeave:Connect(function() tween(row, { BackgroundColor3 = Color3.fromRGB(16, 16, 26) }) end)
    row.MouseButton1Click:Connect(function() redeemManual(code) end)
end

copyAllBtn.MouseButton1Click:Connect(function()
