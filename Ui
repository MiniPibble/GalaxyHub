local logText = new("TextLabel", {
    RichText = true, Text = "", Font = Enum.Font.Code, TextSize = 10, TextColor3 = GRAY,
    TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true,
    BackgroundTransparency = 1, Size = UDim2.new(1, -4, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
    ZIndex = 4, Parent = logScroll,
})

local LOG_COLORS = { info = GRAY, ok = GREEN, warn = AMBER, err = RED }
local logLines, plainLines = {}, {}
local function hex(c)
    return string.format("#%02x%02x%02x", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end
local function esc(s)
    return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

function Hooks.log(msg, kind)
    if msg == S.lastLog then return end
    S.lastLog = msg
    local stamp = os.date("%H:%M:%S")
    local color = LOG_COLORS[kind] or GRAY
    logLines[#logLines + 1] = string.format(
        '<font color="#5a5a74">[%s]</font> <font color="%s">%s</font>', stamp, hex(color), esc(msg))
    plainLines[#plainLines + 1] = "[" .. stamp .. "] " .. msg
    if #logLines > 150 then table.remove(logLines, 1) table.remove(plainLines, 1) end
    logText.Text = table.concat(logLines, "\n")
    task.defer(function() logScroll.CanvasPosition = Vector2.new(0, 1000000) end)
end
copyLogBtn.MouseButton1Click:Connect(function()
    if setclip then
        pcall(setclip, table.concat(plainLines, "\n"))
        toast("Log copied")
    else
        toast("Clipboard not supported")
    end
end)
clearLogBtn.MouseButton1Click:Connect(function()
    logLines, plainLines = {}, {}
    logText.Text = ""
    S.lastLog = nil
    toast("Log cleared")
end)

