}
local theme = THEMES[cfg.theme]
local themed, borders, textGrads, refreshers = {}, {}, {}, {}

local WHITE = Color3.new(1, 1, 1)
local GREEN = Color3.fromRGB(80, 230, 140)
local RED = Color3.fromRGB(255, 90, 100)
local AMBER = Color3.fromRGB(255, 200, 90)
local GRAY = Color3.fromRGB(150, 150, 172)
local OFF = Color3.fromRGB(38, 38, 52)
local PANEL = Color3.fromRGB(13, 13, 21)
local LINE = Color3.fromRGB(34, 34, 52)

local function borderSeq()
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0, theme.a),
        ColorSequenceKeypoint.new(0.35, theme.b),
        ColorSequenceKeypoint.new(0.7, Color3.fromRGB(12, 12, 22)),
        ColorSequenceKeypoint.new(1, theme.a),
    })
end
local function textSeq() return ColorSequence.new(theme.a, theme.b) end

local function paint(obj, prop, key)
    themed[#themed + 1] = { obj, prop, key }
    obj[prop] = theme[key]
end

local function setTheme(i)
    cfg.theme = i
    theme = THEMES[i]
    for _, t in ipairs(themed) do pcall(function() t[1][t[2]] = theme[t[3]] end) end
    for _, g in ipairs(borders) do g.Color = borderSeq() end
    for _, g in ipairs(textGrads) do g.Color = textSeq() end
    for _, f in ipairs(refreshers) do pcall(f) end
    saveConfig()
end

