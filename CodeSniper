-- CORE: SUBMIT A CODE -----------------------------------------------
---------------------------------------------------------------------
local function submitCode(code)
    local pg = PlayerGui
    if not pg then return false, "no PlayerGui" end

    -- 1) dedicated "Codes" gui
    local codesGui = pg:FindFirstChild("Codes")
    if codesGui then
        if codesGui:IsA("ScreenGui") then codesGui.Enabled = true end
        local frame = codesGui:FindFirstChild("Codes") or codesGui
        if frame:IsA("GuiObject") then frame.Visible = true end
        local cur = frame
        while cur and cur ~= codesGui do
            if cur:IsA("GuiObject") then cur.Visible = true end
            cur = cur.Parent
        end

        local box
        for _, d in ipairs(frame:GetDescendants()) do
            if d:IsA("TextBox") and not isOwn(d) then box = d break end
        end

        local btn
        for _, d in ipairs(frame:GetDescendants()) do
            if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOwn(d) then
                local n = d.Name:lower()
                local t = ""
                pcall(function() t = d.Text:lower() end)
                if n:find("submit") or t:find("submit") or n:find("redeem") or t:find("redeem")
                    or n:find("claim") or t:find("confirm") or n:find("enter") then
                    btn = d
                    break
                end
            end
        end
        if not btn then
            for _, d in ipairs(frame:GetDescendants()) do
                if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOwn(d) then
                    local n = d.Name:lower()
                    if not n:find("close") and n ~= "x" and not n:find("toggle") then btn = d break end
                end
            end
        end

        if box then
            pcall(function() box.Text = code end)
            wait(0.05)
            if btn then fireButton(btn) end
            fireFocusLost(box)
            return true, "Codes menu"
        end
    end

    -- 2) dynamic search
    for _, b in ipairs(listCodeButtons(pg)) do
        fireButton(b)
        wait(0.05)
    end
    wait(0.2)

    local box
    local deadline = os.clock() + 2
    while os.clock() < deadline do
        local all = listTextBoxes(pg)
        for _, d in ipairs(all) do
            if isVisible(d) then
                local n = d.Name:lower()
                local pn = (d.Parent and d.Parent.Name or ""):lower()
                if n:find("code") or pn:find("code") or n:find("redeem") or pn:find("redeem")
                    or n:find("input") or pn:find("textbox") or n:find("enter") then
                    box = d
                    break
                end
            end
        end
        if not box then
            for _, d in ipairs(all) do
                if isVisible(d) then box = d break end
            end
        end
        if box then break end
        wait(0.1)
    end
    if not box then return false, "no code box visible" end

    pcall(function() box.Text = code end)
    wait(0.05)

    local btn
    local names = { "submit", "redeem", "claim", "confirm", "enter", "send", "apply", "ok", "use", "go", "check" }
    local p = box.Parent
    for _ = 1, 8 do
        if not p then break end
        for _, d in ipairs(p:GetDescendants()) do
            if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOwn(d) and d ~= box then
                local n = d.Name:lower()
                local t = ""
                pcall(function() t = d.Text:lower() end)
                for _, sn in ipairs(names) do
                    if n:find(sn) or t:find(sn) then
                        if isVisible(d) then btn = d break end
                    end
                end
                if btn then break end
            end
        end
        if btn then break end
        p = p.Parent
    end
    if btn then fireButton(btn) end
    fireFocusLost(box)
    return true, "dynamic search"
end

---------------------------------------------------------------------
-- CORE: CODE BOX WATCHING / PENDING / RETYPE ------------------------
---------------------------------------------------------------------
local function clearBuffer() S.buffer = {} end

local function unwatch()
    if S.textConn then pcall(function() S.textConn:Disconnect() end) end
    if S.ancConn then pcall(function() S.ancConn:Disconnect() end) end
    S.textConn = nil
    S.ancConn = nil
    S.watchedBox = nil
end

local function watch(box)
    if not box or S.watchedBox == box then return end
    unwatch()
    S.watchedBox = box
    if box.Text ~= "" then S.lastText = box.Text end
    S.textConn = box:GetPropertyChangedSignal("Text"):Connect(function()
        if box.Text == "" then clearBuffer() else S.lastText = box.Text end
    end)
    S.ancConn = box.AncestryChanged:Connect(function(_, parent)
        if not parent then clearBuffer() unwatch() end
    end)
end

local function clearPending()
    S.pendingText = nil
    S.pendingBox = nil
    S.pendingUntil = 0
end

local function setPending(text, box)
    if S.pendingText and os.clock() <= S.pendingUntil then return end
    S.pendingToken = S.pendingToken + 1
    local token = S.pendingToken
    S.pendingText = text
    S.pendingBox = box
    S.pendingUntil = os.clock() + 8
    delay(8, function()
        if token == S.pendingToken then clearPending() end
    end)
end

local function retypeInto(box, text)
    if not text or text == "" then return false end
    RunService.Heartbeat:Wait()
    local cb = getCodeBox() or box
    if not cb or not isVisible(cb) then return false end
    local ok = pcall(function() cb.Text = text end)
    if ok then
        S.lastBox = cb
        watch(cb)
    end
    return ok
end

local REJECT = {
    "invalid code", "code is invalid", "expired", "already redeemed", "already used",
    "doesn't exist", "does not exist", "not found", "rejected",
}

local function onTextChanged(text, obj)
    if Unloaded or not S.pendingText then return end
    if os.clock() > S.pendingUntil then clearPending() return end
    if obj and isOwn(obj) then return end
    local lower = tostring(text or ""):lower()
    local hit = false
    for _, p in ipairs(REJECT) do
        if lower:find(p, 1, true) then hit = true break end
    end
    if not hit then return end

    local code, box = S.pendingText, S.pendingBox
    clearPending()
    Stats.invalid = Stats.invalid + 1
    addHistory(code, "Invalid")
    log("Rejected by game: " .. code, "err")
    if cfg.retype and retypeInto(box, code) then
        log("Invalid - repasted: " .. code, "warn")
    end
    refresh()
end

---------------------------------------------------------------------
-- CORE: CAPTURE FLOW ------------------------------------------------
---------------------------------------------------------------------
local function finalizeCode(code, box)
    if cfg.skipDupes and S.seen[code] then
        log("Duplicate skipped: " .. code, "warn")
        return
    end
    S.seen[code] = true
    Stats.captured = Stats.captured + 1
    addHistory(code, "Pending")
    if cfg.autoCopy and setclip then pcall(setclip, code) end
    toast("Captured: " .. code)
    log("Captured: " .. code, "ok")
    refresh()

    if not cfg.autoSubmit then return end

    local ok, msg = submitCode(code)
    if ok then
        Stats.submitted = Stats.submitted + 1
        addHistory(code, "Sent")
        log("Sent: " .. code .. "  (" .. tostring(msg) .. ")", "ok")
        setPending(code, box)
    elseif cfg.retype and retypeInto(box, code) then
        addHistory(code, "Invalid")
        log("Invalid - repasted: " .. code, "warn")
    else
        addHistory(code, "Failed")
        log("Failed: " .. tostring(msg), "err")
    end
    refresh()
end

local function handlePart(text)
    if not text or text == "" or not cfg.autoCode then return end
    if S.watchedBox and not isVisible(S.watchedBox) then clearBuffer() unwatch() end

    local box = getCodeBox()
    S.buffer[#S.buffer + 1] = text
    local combined = table.concat(S.buffer)
    local count = #S.buffer

    if box then
        S.lastBox = box
        watch(box)
        local focused = UIS:GetFocusedTextBox() == box
        pcall(function() box.Text = combined end)
        if focused then
            pcall(function()
                local pos = #combined + 1
                box.CursorPosition = pos
                box.SelectionStart = pos
            end)
        end
    else
        log("Captured; waiting for code UI...", "info")
    end

    log("Pasted " .. count .. "/" .. cfg.submitAfter, "info")

    if count >= cfg.submitAfter then
        clearBuffer()
        finalizeCode(combined, box)
    end
end

local function stripTags(t)
    if type(t) ~= "string" then return tostring(t) end
    return (t:gsub("<[^>]->", ""))
end

local words = {}
local function onNotify(...)
    if not cfg.autoCode then return end
    local text = stripTags(tostring((...) or ""))
    text = text:match("^%s*(.-)%s*$") or ""
    if text == "" or text:find("%s") then return end

    for w in text:gmatch("[%w_]+") do words[#words + 1] = w end
    local need = 1
    if #words < need then return end

    local parts = {}
    for i = 1, math.min(#words, need) do parts[i] = words[i] end
    words = {}

    local captured = table.concat(parts)
    if captured == "" or S.dedupe[captured] then return end
    S.dedupe[captured] = true
    delay(1.25, function() S.dedupe[captured] = nil end)
    handlePart(captured)
end

local function findNotifyRemote()
    if _G.PhiNotifyRemote then return _G.PhiNotifyRemote end
    local pk = ReplicatedStorage:FindFirstChild("Packages")
    local net = pk and pk:FindFirstChild("Net")
    if not net then return nil end
    local info = debug and (debug.getinfo or debug.info)
    if getconns and info then
        for _, d in ipairs(net:GetDescendants()) do
            if d:IsA("RemoteEvent") then
                local ok, cs = pcall(getconns, d.OnClientEvent)
                if ok and type(cs) == "table" then
                    for _, c in ipairs(cs) do
                        local f, fn = pcall(function() return c.Function end)
                        if f and type(fn) == "function" then
                            local i, inf = pcall(info, fn)
                            if i and type(inf) == "table"
                                and tostring(inf.short_src or inf.source or ""):find("NotificationController", 1, true) then
                                return d
                            end
                        end
                    end
                end
            end
        end
    end
    return nil
end

