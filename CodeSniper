local function unload()
    if Unloaded then return end
    Unloaded = true
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    unwatch()
    if getgenv then
        local g = getgenv()
        if g.GalaxyHubNotifyConn then pcall(function() g.GalaxyHubNotifyConn:Disconnect() end) g.GalaxyHubNotifyConn = nil end
        g.GalaxyHubUnload = nil
    end
    pcall(function()
        TweenService:Create(main, TweenInfo.new(0.2), { Size = UDim2.fromOffset(280, 0) }):Play()
    end)
    delay(0.22, function() pcall(function() gui:Destroy() end) end)
end
closeBtn.MouseButton1Click:Connect(unload)
unloadBtn.MouseButton1Click:Connect(unload)
if getgenv then getgenv().GalaxyHubUnload = unload end

