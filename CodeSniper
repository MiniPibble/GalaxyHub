        BackgroundTransparency = 1, Size = UDim2.fromOffset(20, 20), ZIndex = 5, Parent = holder,
    })
    local val = label(holder, {
        Text = tostring(cfg[key]), Font = Enum.Font.GothamBold, TextSize = 11,
        Size = UDim2.fromOffset(32, 20), Position = UDim2.fromOffset(20, 0), ZIndex = 5,
    })
    paint(val, "TextColor3", "a")
    local plus = new("TextButton", {
