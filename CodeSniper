local function switchRow(parent, text, key, onChange, order)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1,
        LayoutOrder = order or 0, ZIndex = 3, Parent = parent,
    })
    label(row, {
        Text = text, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left,
        Size = UDim2.new(1, -56, 1, 0), Position = UDim2.fromOffset(10, 0),
    })
    local track_ = new("TextButton", {
        Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(32, 16),
        Position = UDim2.new(1, -42, 0.5, -8), BackgroundColor3 = OFF, BorderSizePixel = 0,
        ZIndex = 4, Parent = row,
    }, { circle() })
    local pin = new("Frame", {
        Size = UDim2.fromOffset(12, 12), Position = UDim2.new(0, 2, 0.5, -6),
        BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 5, Parent = track_,
    }, { circle() })

    local function render(animate)
        local on = cfg[key]
        local goalC = on and theme.a or OFF
        local goalP = on and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)
        if animate then
            tween(track_, { BackgroundColor3 = goalC }, 0.15)
            tween(pin, { Position = goalP }, 0.15)
        else
            track_.BackgroundColor3 = goalC
            pin.Position = goalP
        end
    end
    render(false)
    refreshers[#refreshers + 1] = function() render(false) end

    track_.MouseButton1Click:Connect(function()
        cfg[key] = not cfg[key]
        render(true)
        saveConfig()
        if onChange then onChange(cfg[key]) end
    end)
    return row
end

local function stepperRow(parent, text, key, minV, maxV, order)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1,
        LayoutOrder = order or 0, ZIndex = 3, Parent = parent,
    })
    label(row, {
