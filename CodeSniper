local function redeemManual(code)
    code = (code or ""):gsub("%s+", "")
    if code == "" then toast("Type a code first") return end
    S.seen[code] = true
    addHistory(code, "Pending")
    log("Manual redeem: " .. code, "info")
    task.spawn(function()
        local ok, msg = submitCode(code)
        if ok then
            Stats.submitted = Stats.submitted + 1
            addHistory(code, "Sent")
            log("Sent: " .. code .. "  (" .. tostring(msg) .. ")", "ok")
            setPending(code, getCodeBox())
            toast("Sent: " .. code)
        else
            addHistory(code, "Failed")
            log("Failed: " .. tostring(msg), "err")
            toast("Failed: " .. tostring(msg))
        end
        refresh()
    end)
end
