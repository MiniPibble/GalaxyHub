track(UIS.TextBoxFocused:Connect(function(box)
    if isOwn(box) then return end
    if box ~= getCodeBox() then return end
    S.focusedBox = box
    S.lastBox = box
    watch(box)
    if cfg.autoCode then log("Ready - code box detected", "ok") end
end))

track(UIS.TextBoxFocusReleased:Connect(function(box)
    if isOwn(box) then return end
    local current = getCodeBox()
    if box ~= current and box ~= S.lastBox then return end
    local text = box.Text ~= "" and box.Text or S.lastText
    if text ~= "" then setPending(text, box) end
    if S.focusedBox == box then
        S.focusedBox = nil
        if cfg.autoCode then log("Click code box first", "info") end
    end
end))

local function hookText(obj)
    if not (obj:IsA("TextLabel") or obj:IsA("TextButton")) then return end
    onTextChanged(obj.Text or "", obj)
    obj:GetPropertyChangedSignal("Text"):Connect(function()
        if not Unloaded then onTextChanged(obj.Text or "", obj) end
    end)
end
pcall(function()
    for _, o in ipairs(PlayerGui:GetDescendants()) do hookText(o) end
end)
track(PlayerGui.DescendantAdded:Connect(function(o)
    wait(0.04)
    if not Unloaded and o.Parent then hookText(o) end
end))

task.spawn(function()
    local remote
    for _ = 1, 20 do
        if Unloaded then return end
        remote = findNotifyRemote()
        if remote then break end
        wait(0.5)
    end
    if Unloaded then return end
    if not remote then
        log("Notifier not found - use manual redeem", "warn")
        refresh()
        return
    end
    if getgenv then
        local prev = getgenv().GalaxyHubNotifyConn
        if prev then pcall(function() prev:Disconnect() end) end
    end
    local c = remote.OnClientEvent:Connect(function(...) pcall(onNotify, ...) end)
    if getgenv then getgenv().GalaxyHubNotifyConn = c end
    track(c)
    S.hooked = true
    log("Notifier hooked: " .. remote.Name, "ok")
    refresh()
end)

