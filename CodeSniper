local LOG_COLORS = { info = GRAY, ok = GREEN, warn = AMBER, err = RED }
local logLines, plainLines = {}, {}
local function hex(c)
    return string.format("#%02x%02x%02x", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end
local function esc(s)
    return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

function Hooks.log(msg, kind)
    if msg == S.lastLog then return end
    S.lastLog = msg
    local stamp = os.date("%H:%M:%S")
    local color = LOG_COLORS[kind] or GRAY
    logLines[#logLines + 1] = string.format(
        '<font color="#5a5a74">[%s]</font> <font color="%s">%s</font>', stamp, hex(color), esc(msg))
    plainLines[#plainLines + 1] = "[" .. stamp .. "] " .. msg
    if #logLines > 150 then table.remove(logLines, 1) table.remove(plainLines, 1) end
    logText.Text = table.concat(logLines, "\n")
    task.defer(function() logScroll.CanvasPosition = Vector2.new(0, 1000000) end)
end
