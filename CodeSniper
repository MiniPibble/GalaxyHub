function Hooks.refresh()
    statNums.captured.Text = tostring(Stats.captured)
    statNums.submitted.Text = tostring(Stats.submitted)
    statNums.invalid.Text = tostring(Stats.invalid)
    local on = cfg.autoCode
    local col = on and GREEN or RED
    if not on then
        statusLabel.Text = "Paused"
    elseif S.hooked then
        statusLabel.Text = "Scanning for codes"
    else
        statusLabel.Text = "Waiting for notifier (manual works)"
    end
    statusLabel.TextColor3 = col
    dot.BackgroundColor3 = col
end

