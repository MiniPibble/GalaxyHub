local GUI_NAME = "GalaxyHub"

local function isOwn(x)
    local y = x
    for _ = 1, 12 do
        if not y then break end
        if y.Name == GUI_NAME then return true end
        y = y.Parent
    end
    return false
end

local function isVisible(x)
    local y = x
    while y do
        if y:IsA("GuiObject") and not y.Visible then return false end
        if y:IsA("ScreenGui") then return y.Enabled end
        y = y.Parent
    end
    return true
end

local function listTextBoxes(pg)
    local r = {}
    for _, g in ipairs(pg:GetChildren()) do
        if g:IsA("ScreenGui") and g.Enabled and not isOwn(g) then
            for _, d in ipairs(g:GetDescendants()) do
                if d:IsA("TextBox") and not isOwn(d) then r[#r + 1] = d end
            end
        end
    end
    return r
end

local function listCodeButtons(pg)
    local r = {}
    for _, g in ipairs(pg:GetChildren()) do
        if g:IsA("ScreenGui") and g.Enabled and not isOwn(g) then
            for _, d in ipairs(g:GetDescendants()) do
                if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOwn(d) then
                    local n = d.Name:lower()
                    local pn = (d.Parent and d.Parent.Name or ""):lower()
                    if (n:find("code") or n:find("redeem") or pn:find("code") or pn:find("redeem")) and isVisible(d) then
                        r[#r + 1] = d
                    end
                end
            end
        end
    end
    return r
end

local function getCodeBox()
    for _, b in ipairs(listTextBoxes(PlayerGui)) do
        if isVisible(b) then return b end
    end
    return nil
end

local function fireButton(b)
    if not b then return false end
    local m = {}
    m[#m + 1] = function() b.MouseButton1Click:Fire() end
    m[#m + 1] = function() b.Activated:Fire() end
    if typeof(firesignal) == "function" then
        m[#m + 1] = function() firesignal(b.MouseButton1Click) end
        m[#m + 1] = function() firesignal(b.Activated) end
    end
    if typeof(getconns) == "function" then
        m[#m + 1] = function()
            local ok, cs = pcall(getconns, b.MouseButton1Click)
            if ok and type(cs) == "table" then
                for _, c in ipairs(cs) do pcall(function() c:Fire() end) end
            end
            local ok2, cs2 = pcall(getconns, b.Activated)
            if ok2 and type(cs2) == "table" then
                for _, c in ipairs(cs2) do pcall(function() c:Fire() end) end
            end
        end
    end
    if typeof(fireclick) == "function" then m[#m + 1] = function() fireclick(b) end end
    local any = false
    for _, f in ipairs(m) do
        local ok = pcall(f)
        any = any or ok
    end
    return any
end

local function fireFocusLost(box)
    if not box then return false end
    local any = false
    if typeof(firesignal) == "function" then
        local ok = pcall(firesignal, box.FocusLost, true)
        any = any or ok
    end
    if typeof(getconns) == "function" then
        local ok, cs = pcall(getconns, box.FocusLost)
        if ok and type(cs) == "table" then
            for _, c in ipairs(cs) do
                local fn
                pcall(function() fn = c.Function end)
                if fn and typeof(getups) == "function" and typeof(setup) == "function" then
                    local uok, ups = pcall(getups, fn)
                    if uok and type(ups) == "table" then
                        for i, v in pairs(ups) do
                            if type(v) == "boolean" and v == true then pcall(setup, fn, i, false) end
                        end
                    end
                end
                local fok = pcall(function() if c.Enabled ~= false then c:Fire(true) end end)
                any = any or fok
            end
        end
    end
    return any
end

